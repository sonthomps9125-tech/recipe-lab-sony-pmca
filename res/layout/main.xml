<?xml version="1.0" encoding="utf-8"?>
<!-- Sony NEX-6 16:9 Wide Layout for Recipe Lab -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="#FF000000">

    <!-- 1. Live view preview surface (positioned on the left in 3:2 aspect ratio) -->
    <SurfaceView
        android:id="@+id/surface"
        android:layout_width="480dp"
        android:layout_height="fill_parent"
        android:layout_gravity="left|center_vertical" />

    <!-- 2. Top OSD Bar across 3:2 frame: Faded by 65% (#59000000) showing recipe title and badges -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="480dp"
        android:layout_height="34dp"
        android:layout_gravity="top|left"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#59000000"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="gone">

        <!-- App Icon -->
        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="#FF1E88E5"
            android:layout_marginRight="6dp" />

        <com.voxivoid.recipelab.EdgeTextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:singleLine="true" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:paddingLeft="5dp" android:paddingRight="5dp"
            android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/badge_ok" />

        <TextView
            android:id="@+id/edited"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:paddingLeft="5dp" android:paddingRight="5dp"
            android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF"
            android:background="@drawable/badge_edited"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:paddingLeft="4dp" android:paddingRight="4dp"
            android:paddingTop="1dp" android:paddingBottom="1dp"
            android:textSize="8sp"
            android:textStyle="bold"
            android:textColor="#DDFFFFFF"
            android:background="@drawable/chip"
            android:visibility="gone" />

        <com.voxivoid.recipelab.StarView
            android:id="@+id/fav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 3. Bottom Camera Exposure Bar across 3:2 frame: 1/125 F4.0 [EV] +0.3 [ISO] 400 -->
    <com.voxivoid.recipelab.ExposureBar
        android:id="@+id/exposure_bar"
        android:layout_width="480dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|left"
        android:visibility="gone" />

    <!-- 4. Dedicated Right Control Sidebar (in the 16:9 black pillarbox zone) -->
    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="160dp"
        android:layout_height="fill_parent"
        android:layout_gravity="right"
        android:orientation="vertical"
        android:background="#FF121212"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Top Right SoftKey 1: EXIT ● -->
        <TextView
            android:id="@+id/exit_btn"
            android:layout_width="fill_parent"
            android:layout_height="26dp"
            android:gravity="right|center_vertical"
            android:paddingRight="4dp"
            android:text="EXIT ●"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFFFF" />

        <!-- Hidden compat elements for MainActivity -->
        <TextView
            android:id="@+id/count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/name_original"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Vertical parameter icon container (pure graphic tiles) -->
        <ScrollView
            android:id="@+id/chipscroll"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal" />
        </ScrollView>

        <!-- Edit actions row: [ Apply ] and [ Discard ] -->
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <!-- Bottom Right SoftKey 2: OPTION · Edit ● -->
        <TextView
            android:id="@+id/option_btn"
            android:layout_width="fill_parent"
            android:layout_height="26dp"
            android:gravity="right|center_vertical"
            android:paddingRight="4dp"
            android:text="OPTION · Edit ●"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFF2B85C" />

        <com.voxivoid.recipelab.HintBar
            android:id="@+id/hints"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <com.voxivoid.recipelab.SponsorLine
            android:id="@+id/sponsor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Minimal overlay: recipe pill -->
    <TextView
        android:id="@+id/mini"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_margin="10dp"
        android:paddingLeft="10dp" android:paddingRight="10dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/pill"
        android:visibility="gone" />

    <!-- Sony PMCA MenuListView brand browser -->
    <com.voxivoid.recipelab.PickerView
        android:id="@+id/picker"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone" />

    <!-- QR code sharing & scanner view (from v1.13.0) -->
    <com.voxivoid.recipelab.QrView
        android:id="@+id/qr"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone" />

    <!-- RAW / JPEG prompt dialog -->
    <com.voxivoid.recipelab.PromptView
        android:id="@+id/prompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- App menu: full screen -->
    <com.voxivoid.recipelab.MenuView
        android:id="@+id/menu"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone" />

    <!-- Name editor for custom recipes: full screen -->
    <com.voxivoid.recipelab.KeyboardView
        android:id="@+id/keyboard"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:visibility="gone" />

    <!-- Transient status toast -->
    <TextView
        android:id="@+id/toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="38dp"
        android:paddingLeft="12dp" android:paddingRight="12dp"
        android:paddingTop="5dp" android:paddingBottom="5dp"
        android:textSize="12sp"
        android:textColor="#FFFFFFFF"
        android:background="@drawable/toast_bg"
        android:visibility="gone" />
</FrameLayout>
